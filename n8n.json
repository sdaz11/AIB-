      "name": "AEGIS Case Intake",
      "webhookId": "207b2d24-1342-45e1-9128-11a424c82bf8"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body ?? item;\n\nconst required = [\n  \"case_id\",\n  \"risk_level\",\n  \"risk_score\",\n  \"governance_action\",\n  \"route\"\n];\n\nconst missing = required.filter(\n  (field) =>\n    body[field] === undefined ||\n    body[field] === null ||\n    body[field] === \"\"\n);\n\nconst allowedRiskLevels = [\"LOW\", \"MEDIUM\", \"HIGH\", \"UNKNOWN\"];\n\nconst errors = [];\n\nif (missing.length) {\n  errors.push(`Missing required fields: ${missing.join(\", \")}`);\n}\n\nif (\n  body.risk_level &&\n  !allowedRiskLevels.includes(String(body.risk_level).toUpperCase())\n) {\n  errors.push(\"Invalid risk_level\");\n}\n\nif (\n  body.risk_score !== undefined &&\n  body.risk_score !== null &&\n  (\n    typeof Number(body.risk_score) !== \"number\" ||\n    Number.isNaN(Number(body.risk_score)) ||\n    Number(body.risk_score) < 0 ||\n    Number(body.risk_score) > 100\n  )\n) {\n  errors.push(\"risk_score must be between 0 and 100\");\n}\n\nreturn [\n  {\n    json: {\n      ...body,\n      orchestration: {\n        payload_valid: errors.length === 0,\n        validation_errors: errors,\n        validated_by: \"n8n\",\n        authority: \"PYTHON_GOVERNANCE\",\n        banking_action_executed: false\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        32
      ],
      "id": "62beb00b-ed2b-424d-8564-de0807035f80",
      "name": "Validate Governed Payload"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  accepted: true,\n  case_id: $json.case_id ?? null,\n  risk_level: $json.risk_level ?? \"UNKNOWN\",\n  risk_score: $json.risk_score ?? null,\n  governance_action: $json.governance_action ?? null,\n  route: $json.route ?? null,\n\n  workflow_state:\n    $json.risk_level === \"MEDIUM\"\n      ? \"AWAITING_HUMAN_VERIFICATION\"\n      : \"AWAITING_HUMAN_REVIEW\",\n\n  resume_url: $execution.resumeUrl,\n\n  authority: \"PYTHON_GOVERNANCE\",\n  banking_action_executed: false,\n\n  message:\n    $json.risk_level === \"MEDIUM\"\n      ? \"MEDIUM-risk case accepted by n8n and requires human verification.\"\n      : \"HIGH-risk case accepted by n8n and requires human review.\"\n}) }}",
        "options": {}
      },
