    {
      "parameters": {
        "jsCode": "// ============================================================\n// AEGIS 2.0\n// FINAL GOVERNED AUDIT RECORD\n// ============================================================\n//\n// PURPOSE:\n// 1. Preserve original Python governance decisions.\n// 2. Record validated Human-in-the-Loop decisions.\n// 3. Preserve original attempted human decisions.\n// 4. Record deterministic guardrail enforcement.\n// 5. Capture validation errors for audit transparency.\n// 6. Support autonomous LOW-risk workflows.\n// 7. Preserve escalation and fail-safe outcomes.\n// 8. Ensure no banking action is executed.\n//\n// ============================================================\n\n\n// STEP 1: Retrieve final workflow outcome\n\nconst outcome = $input.first().json;\n\n\n// STEP 2: Retrieve original deterministic\n// Python-governed case\n\nconst governed = $('Validate Governed Payload').first().json;\n\n\n// STEP 3: Safely retrieve guardrail-validated\n// human decision.\n//\n// LOW-risk autonomous workflows may not execute\n// the Human Decision Guardrail node.\n\nlet human = null;\n\ntry {\n  human = $('Enforce Fail-Safe Decision Guardrail').first().json;\n} catch (error) {\n  human = null;\n}\n\n\n// STEP 4: Determine whether human review occurred\n\nconst humanReviewOccurred = human !== null;\n\n\n// STEP 5: Construct final governed audit record\n\nreturn [\n  {\n    json: {\n\n      // =====================================================\n      // AUDIT EVENT\n      // =====================================================\n\n      audit_event: \"AEGIS_WORKFLOW_OUTCOME\",\n\n\n      // =====================================================\n      // CASE IDENTITY\n      // =====================================================\n\n      case_id:\n        outcome.case_id ??\n        human?.case_id ??\n        governed.case_id ??\n        null,\n\n\n      // =====================================================\n      // ORIGINAL PYTHON GOVERNANCE\n      // =====================================================\n\n      original_governance: {\n\n        risk_level:\n          governed.risk_level ?? null,\n\n        risk_score:\n          governed.risk_score ?? null,\n\n        governance_action:\n          governed.governance_action ?? null,\n\n        route:\n          governed.route ?? null,\n\n        authority:\n          governed.orchestration?.authority ??\n          \"PYTHON_GOVERNANCE\"\n\n      },\n\n\n      // =====================================================\n      // HUMAN REVIEW AND GUARDRAIL TRANSPARENCY\n      // =====================================================\n\n      human_review: {\n\n        occurred: humanReviewOccurred,\n\n        // Effective decision after guardrail validation\n        decision:\n          human?.human_decision ?? null,\n\n        // Original decision submitted by investigator\n        original_decision:\n          human?.original_human_decision ?? null,\n\n        // Whether deterministic guardrail blocked it\n        guardrail_blocked:\n          human?.fail_safe_guardrail?.decision_blocked ??\n          false,\n\n        // Detailed validation failures\n        validation_errors:\n          human?.human_review?.validation_errors ??\n          [],\n\n        investigator:\n          human?.investigator ?? null,\n\n        rationale:\n          human?.rationale ?? null,\n\n        decision_source:\n          human?.decision_source ?? null,\n\n        validation_passed:\n          humanReviewOccurred\n            ? (human?.human_review?.valid ?? false)\n            : null\n\n      },\n\n\n      // =====================================================\n      // FINAL WORKFLOW OUTCOME\n      // =====================================================\n\n      workflow_outcome:\n        outcome.workflow_outcome ?? null,\n\n      workflow_status:\n        outcome.workflow_status ?? null,\n\n      workflow_layer:\n        outcome.workflow_layer ??\n        \"n8n_orchestration\",\n\n\n      // =====================================================\n      // DECISION AUTHORITY\n      // =====================================================\n\n      decision_authority:\n        outcome.decision_authority ??\n        (\n          humanReviewOccurred\n            ? \"HUMAN_INVESTIGATOR\"\n            : \"PYTHON_GOVERNANCE\"\n        ),\n\n\n      // =====================================================\n      // BANKING ACTION SAFETY\n      // =====================================================\n\n      banking_action_executed: false,\n\n\n      // =====================================================\n      // ORCHESTRATION COMPLETION STATUS\n      // =====================================================\n\n      orchestration_complete:\n        outcome.orchestration_complete === true,\n\n\n      // =====================================================\n      // AUDIT METADATA\n      // =====================================================\n\n      audit_metadata: {\n\n        recorded_at:\n          new Date().toISOString(),\n\n        source: \"n8n\",\n\n        prototype_environment: true,\n\n        immutable_audit_claim: false\n\n      }\n\n    }\n  }\n];"
      },
