      "name": "Fail-Safe Intake Response"
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// AEGIS 2.0\n// DETERMINISTIC FAIL-SAFE HUMAN DECISION GUARDRAIL\n// ============================================================\n//\n// PURPOSE:\n// 1. Preserve Python governance authority.\n// 2. Validate human decisions against original case evidence.\n// 3. Prevent unsafe approval of INVALID / UNKNOWN cases.\n// 4. Prevent rejected decisions from entering approved routes.\n// 5. Preserve original decisions for auditability.\n// 6. Never execute banking actions.\n//\n// ============================================================\n\n\n// STEP 1: Retrieve the validated human decision\n\nconst decision = $input.first().json;\n\n\n// STEP 2: Retrieve original Python-governed evidence\n\nconst governed = $('Validate Governed Payload').first().json;\n\n\n// STEP 3: Identify original governance classification\n\nconst riskLevel = String(\n  governed.risk_level ?? \"UNKNOWN\"\n).trim().toUpperCase();\n\nconst payloadValid =\n  governed.orchestration?.payload_valid === true;\n\n\n// STEP 4: Identify mandatory fail-safe conditions\n\nconst isFailSafe =\n  !payloadValid || riskLevel === \"UNKNOWN\";\n\n\n// STEP 5: Define permitted fail-safe human decisions\n\nconst allowedFailSafeDecisions = [\n  \"HOLD AND REVIEW\",\n  \"ESCALATE TO SENIOR INVESTIGATOR\"\n];\n\n\n// STEP 6: Preserve existing validation errors\n\nconst errors = Array.isArray(\n  decision.human_review?.validation_errors\n)\n  ? [...decision.human_review.validation_errors]\n  : [];\n\n\n// STEP 7: Validate original case identity\n\nconst originalCaseId = String(\n  governed.case_id ?? \"\"\n).trim();\n\nconst decisionCaseId = String(\n  decision.case_id ?? \"\"\n).trim();\n\nif (\n  !originalCaseId ||\n  originalCaseId !== decisionCaseId\n) {\n  errors.push(\n    \"Human decision case ID does not match the original governed case.\"\n  );\n}\n\n\n// STEP 8: Preserve the investigator's original decision\n\nconst originalHumanDecision =\n  decision.human_decision ?? null;\n\n\n// STEP 9: Enforce mandatory fail-safe restrictions\n\nconst blockedDecision =\n  isFailSafe &&\n  !allowedFailSafeDecisions.includes(\n    originalHumanDecision\n  );\n\nif (blockedDecision) {\n  errors.push(\n    \"FAIL-SAFE GUARDRAIL: Invalid or UNKNOWN cases cannot proceed or complete ordinary verification without resolving governance concerns.\"\n  );\n}\n\n\n// STEP 10: Calculate final deterministic validation\n\nconst finalValid =\n  decision.human_review?.valid === true &&\n  errors.length === 0;\n\n\n// STEP 11: Prevent rejected decisions from entering\n// ordinary approved workflow branches\n\nconst safeHumanDecision = finalValid\n  ? originalHumanDecision\n  : \"INVALID_FAIL_SAFE_DECISION\";\n\n\n// STEP 12: Return governed and audit-ready decision\n\nreturn [\n  {\n    json: {\n\n      ...decision,\n\n      // Preserve the original investigator decision\n      original_human_decision: originalHumanDecision,\n\n      // Only permit validated decisions to enter routing\n      human_decision: safeHumanDecision,\n\n      // Updated human-review validation\n      human_review: {\n\n        ...decision.human_review,\n\n        valid: finalValid,\n\n        validation_errors: errors\n\n      },\n\n      // Deterministic governance metadata\n      fail_safe_guardrail: {\n\n        checked: true,\n\n        applied: isFailSafe,\n\n        decision_blocked: blockedDecision,\n\n        original_payload_valid: payloadValid,\n\n        original_risk_level: riskLevel,\n\n        original_case_id: originalCaseId || null,\n\n        original_human_decision: originalHumanDecision,\n\n        effective_human_decision: safeHumanDecision,\n\n        requires_manual_review: isFailSafe,\n\n        validation_passed: finalValid,\n\n        authority: \"DETERMINISTIC_GOVERNANCE\"\n\n      },\n\n      // Absolute prototype safety restriction\n      banking_action_executed: false\n\n    }\n  }\n];"
      },
