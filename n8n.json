    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body ?? item;\n\nconst allowedDecisions = [\n  \"VERIFY CUSTOMER\",\n  \"HOLD AND REVIEW\",\n  \"PROCEED\",\n  \"ESCALATE TO SENIOR INVESTIGATOR\"\n];\n\nconst humanDecision = String(\n  body.human_decision ?? \"\"\n).trim().toUpperCase();\n\nconst investigator = String(\n  body.investigator ?? \"\"\n).trim();\n\nconst rationale = String(\n  body.rationale ?? \"\"\n).trim();\n\nconst caseId = String(\n  body.case_id ?? \"\"\n).trim();\n\nconst errors = [];\n\nif (!caseId) {\n  errors.push(\"Missing case_id\");\n}\n\nif (!humanDecision) {\n  errors.push(\"Missing human_decision\");\n}\n\nif (\n  humanDecision &&\n  !allowedDecisions.includes(humanDecision)\n) {\n  errors.push(\"Invalid human_decision\");\n}\n\nif (!investigator) {\n  errors.push(\"Missing investigator\");\n}\n\nif (!rationale) {\n  errors.push(\"Missing rationale\");\n}\n\nreturn [\n  {\n    json: {\n      case_id: caseId || null,\n      human_decision: humanDecision || null,\n      investigator: investigator || null,\n      rationale: rationale || null,\n      decision_source:\n        body.decision_source ?? \"HUMAN_INVESTIGATOR\",\n\n      human_review: {\n        valid: errors.length === 0,\n        validation_errors: errors,\n        validated_by: \"n8n\",\n        authority: \"HUMAN_INVESTIGATOR\"\n      },\n\n      banking_action_executed: false\n    }\n  }\n];"
      },
