    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  accepted: true,\n\n  case_id: $json.case_id ?? null,\n\n  risk_level: \"UNKNOWN\",\n\n  submitted_risk_level: $json.risk_level ?? null,\n\n  workflow_state: \"AWAITING_FAIL_SAFE_MANUAL_REVIEW\",\n\n  workflow_outcome: \"FAIL_SAFE_MANUAL_REVIEW\",\n\n  workflow_status: \"MANUAL_REVIEW_REQUIRED\",\n\n  validation_errors:\n    $json.orchestration?.validation_errors ?? [],\n\n  human_review_required: true,\n\n  resume_url: $execution.resumeUrl || null,\n\n  decision_authority: \"FAIL_SAFE_GOVERNANCE\",\n\n  banking_action_executed: false,\n\n  orchestration_complete: false,\n\n  message: \"Case requires mandatory manual review due to invalid or incomplete governance evidence. No banking action has been executed.\"\n}) }}",
